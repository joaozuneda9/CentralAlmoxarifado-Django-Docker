# Configuração do Central Almoxarifado. No servidor, o compose.yaml lê este arquivo (copiado
# para .env) e trata "$" como variável: senha com "$" vai entre aspas simples ('a$b'), senão
# muda em silêncio. Cada linha é NOME=valor, sem espaços em volta do "=".

# Chave secreta do Django (obrigatória com DEBUG=0). Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# 1 só no computador de desenvolvimento; 0 no servidor.
DEBUG=1
# Nomes pelos quais o site é acessado, separados por vírgula (ex.: almoxarifado.saep.local).
ALLOWED_HOSTS=
# Origens confiáveis para formulários, com esquema (ex.: https://almoxarifado.saep.local).
CSRF_TRUSTED_ORIGINS=
# 1 quando o site é servido por HTTPS (cookies seguros, redirecionamento e HSTS).
USAR_HTTPS=1
# 1 quando o HTTPS termina num proxy HTTPS que envia X-Forwarded-Proto. No compose, o
# waitress já confia nesse cabeçalho e no X-Forwarded-For (o IP real de quem pede, usado nos
# limites por IP dos formulários). Fora do Docker, rode o waitress com
#   --trusted-proxy=127.0.0.1 --trusted-proxy-headers="x-forwarded-proto x-forwarded-for"
PROXY_HTTPS=0
# Prefixo do site atrás do proxy (ex.: /almoxarifado). O compose o passa ao --url-prefix do
# waitress. Vazio = o site na raiz.
PREFIXO_URL=
# Novos ambientes (compose.ambientes.yaml): somente o numero da porta, sem IP.
# O bind 127.0.0.1 e fixo no Compose. Producao: 8011; desenvolvimento: 8012.
PORTA_WEB=8011
# LEGADO (somente compose.yaml): preservado para nao alterar a instalacao atual.
# Onde o container do sistema atende, para o proxy encaminhar. Só o proxy pode alcançar este
# endereço (o waitress confia nos cabeçalhos de qualquer origem):
#   Proxy no mesmo servidor (WSL2): 127.0.0.1:8010
#   Proxy em outra máquina (VM Linux): <ip desta máquina na rede do proxy>:8010, com o
#   firewall liberando só o IP do proxy. Nunca 0.0.0.0.
PORTA_PUBLICADA=127.0.0.1:8010
# Banco MariaDB do compose (criado na primeira subida com estes valores) ou MySQL/MariaDB
# local no desenvolvimento.
DB_NAME=almoxarifado
DB_USER=almox
DB_PASSWORD=
# A senha do root do MariaDB não fica aqui: está em .env.banco (copie de .env.banco.example),
# que só o container do banco lê.
# Usuário e senha do SCPI usados pelos robôs.
SAEP_USER=
SAEP_PASS=
# Endereço do SCPI, sempre https:// (vazio = https://transparencia.saep.sp.gov.br:8445/scpi9/).
SCPI_URL=
# 1 libera o lançamento real no SCPI. Fica 0 (só a simulação roda) em todo ambiente que não é
# o que lança de verdade, como o desenvolvimento e as cópias de teste.
LANCAMENTO_REAL=0
# Bot e chat do Telegram que recebem o aviso de novo pedido.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Chat da Segurança do Trabalho (o mesmo bot): avisado dos pedidos de EPI que aguardam
# autorização. Vazio = o aviso não sai e a Segurança do Trabalho consulta a fila.
TELEGRAM_CHAT_ID_SEGURANCA=

# Só no desenvolvimento local (o compose define estas e ignora o que estiver aqui).
# Banco local.
DB_HOST=127.0.0.1
DB_PORT=3306
# 1 abre o navegador dos robôs sem janela.
SCPI_HEADLESS=0
# Pasta do perfil do navegador dos robôs (vazio = .pw-profile/ na raiz do projeto).
SCPI_PERFIL_DIR=
# Pasta do Chromium do Playwright (vazio = a pasta do usuário que rodou "playwright install").
PLAYWRIGHT_BROWSERS_PATH=
# Pasta dos logs (vazio = logs/ na raiz do projeto).
LOG_DIR=
# Pasta dos backups do banco, fora do repositório (vazio = ../backups-almoxarifado).
BACKUP_DIR=
# Programa do dump: mysqldump (MySQL) ou mariadb-dump (MariaDB), com o caminho se não estiver no PATH.
MYSQLDUMP=
